{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tailwind-color",
	"compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
	"observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
}
